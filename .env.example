# Claude via Amazon Bedrock (Anthropic-compatible gateway).
# Copy this file to `.env` and fill in your real values.
# Without ANTHROPIC_AUTH_TOKEN, the app runs against a mock provider that
# returns canned components instead of calling Claude.

# Bearer token used to authenticate against the gateway.
ANTHROPIC_AUTH_TOKEN=your-auth-token-here

# Anthropic-compatible gateway root (no path). The app appends `/v1`
# automatically, so use the same value as your Claude Code ANTHROPIC_BASE_URL,
# e.g. https://your-gateway.example.com
ANTHROPIC_BASE_URL=https://your-gateway.example.com

# Bedrock base URL from your Claude Code config. Kept for reference / the
# alternative native-Bedrock integration; not used by the current provider.
ANTHROPIC_BEDROCK_BASE_URL=https://your-gateway.example.com/bedrock

# Optional: override the model id. Must match an id returned by
# `GET /v1/models` on your gateway (the bare "claude-haiku-4-5" alias is not
# accepted; use the dated id).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
