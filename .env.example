# Claude via Amazon Bedrock (Anthropic-compatible gateway).
# Copy this file to `.env` and fill in your real values.
# Without ANTHROPIC_AUTH_TOKEN, the app runs against a mock provider that
# returns canned components instead of calling Claude.

# Bearer token used to authenticate against the gateway.
ANTHROPIC_AUTH_TOKEN=your-auth-token-here

# Anthropic-compatible base URL for the gateway. This MUST point at the
# Anthropic Messages API root (typically ending in `/v1`), e.g.
# https://your-gateway.example.com/v1
ANTHROPIC_BASE_URL=https://your-gateway.example.com/v1

# Bedrock-specific base URL. Used automatically as a fallback if
# ANTHROPIC_BASE_URL is not set.
ANTHROPIC_BEDROCK_BASE_URL=https://your-bedrock-gateway.example.com

# Optional: override the Claude model name exposed by your gateway.
# ANTHROPIC_MODEL=claude-haiku-4-5
